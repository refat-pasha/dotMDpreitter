# =========================================================================
# dotMDpritter — environment settings
# Copy to `.env` for local reference, or set these in your host's dashboard.
# There is nothing secret here by default: no API keys, no database URLs.
# =========================================================================

# Port the server listens on. Most PaaS platforms inject this automatically.
PORT=4173

# Where accounts, sessions and every user's .md files are stored.
# MUST point at a persistent volume in production, or redeploys wipe all data.
#   Docker:  a named volume or bind mount at /data
#   Render:  a disk mounted at /data
#   Railway: a volume mounted at /data
#   VPS:     any directory, e.g. /var/lib/dotmdpritter
DOTMD_DATA=./data

# Set to 1 when the app is served over HTTPS so the session cookie carries
# the `Secure` flag. Optional: the app also trusts the standard
# X-Forwarded-Proto / X-Forwarded-Ssl proxy headers, so most reverse proxies
# and PaaS TLS termination are detected automatically.
DOTMD_SECURE=0

# ---------------------------------------------------------------------------
# Password reset email (optional)
# ---------------------------------------------------------------------------
# Without these, "Forgot your password?" still works: the reset link is printed
# in the server console instead of being emailed. Set these to send it by email.
# DotMDpritter speaks SMTP directly and has no npm dependencies.
#
# Gmail needs an App Password, not your account password:
#   https://myaccount.google.com/apppasswords
#
# DOTMD_SMTP_HOST=smtp.gmail.com
# DOTMD_SMTP_PORT=587          # 587 = STARTTLS, 465 = implicit TLS
# DOTMD_SMTP_SECURE=0          # set to 1 only for port 465
# DOTMD_SMTP_USER=you@gmail.com
# DOTMD_SMTP_PASS=your-16-char-app-password
# DOTMD_MAIL_FROM=dotMDpritter <no-reply@you@gmail.com>
#
# Only if your relay uses a certificate Node cannot verify (a self-hosted
# Postfix, say). Leave unset for Gmail/Outlook/Fastmail — turning this on
# means anything on the network could read the reset link.
# DOTMD_SMTP_INSECURE=0
#
# The link is built from the incoming request, honouring X-Forwarded-Proto and
# X-Forwarded-Host. Behind a proxy that hides the public hostname, set this so
# the emailed link points at the address the user can actually open:
# DOTMD_PUBLIC_URL=https://notes.example.com

# --- Not configurable (deliberately) ---
# Bind address: the server listens on all interfaces so a container or proxy
# can reach it. Do not expose it directly to the internet without a reverse
# proxy or platform router handling TLS and rate limiting.
